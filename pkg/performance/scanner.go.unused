// isValidGameFile checks if file extension is valid for game files
func (s *OptimizedFileScanner) isValidGameFile(ext string) bool {
	validExts := []string{".nsp", ".nsz", ".xci", ".xcz"}
	for _, validExt := range validExts {
		if ext == validExt {
			return true
		}
	}
	return false
}

// checkMemoryUsage monitors memory usage and returns error if limit exceeded
func (s *OptimizedFileScanner) checkMemoryUsage() error {
	var m runtime.MemStats
	runtime.ReadMemStats(&m)

	currentMB := float64(m.Alloc) / 1024 / 1024
	s.mu.Lock()
	s.metrics.MemoryUsageMB = currentMB
	s.mu.Unlock()

	if currentMB > float64(s.config.MemoryLimit) {
		return &MemoryLimitExceededError{
			Current: currentMB,
			Limit:   float64(s.config.MemoryLimit),
		}
	}

	return nil
}

// GetMetrics returns current scan metrics
func (s *OptimizedFileScanner) GetMetrics() *ScanMetrics {
	s.mu.RLock()
	defer s.mu.RUnlock()

	// Return a copy of metrics
	metrics := *s.metrics
	return &metrics
}

// Stop gracefully stops the scanner
func (s *OptimizedFileScanner) Stop() {
	s.cancel()
}

// MemoryLimitExceededError represents memory limit exceeded error
type MemoryLimitExceededError struct {
	Current float64
	Limit   float64
}

func (e *MemoryLimitExceededError) Error() string {
	return fmt.Sprintf("memory usage %.1fMB exceeds limit %.1fMB", e.Current, e.Limit)
}

